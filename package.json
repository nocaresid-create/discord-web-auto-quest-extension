    "jsdom": "^30.0.1",
    "svelte": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
